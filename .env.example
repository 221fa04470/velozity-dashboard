# Used by docker-compose.yml. Copy to .env (never commit .env).
# These placeholders are for LOCAL development only. Generate real ones for any deployed environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=local-dev-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me-0123456789abcdef
SEED_PASSWORD=Password123!
