// Velozity — Client Project Dashboard schema (PostgreSQL)
//
// Indexing notes live in the root README ("Indexing decisions"); short version:
//  * every FK that is used in a WHERE / JOIN has an index (Postgres does not create them automatically)
//  * composite indexes match the access paths of the role-scoped queries (project+status, assignee+status, ...)

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PROJECT_MANAGER
  DEVELOPER
}

// Declaration order matters: Postgres sorts enums by declaration order,
// so ORDER BY priority DESC gives CRITICAL > HIGH > MEDIUM > LOW without a CASE expression.
enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum ActivityType {
  TASK_CREATED
  STATUS_CHANGED
  ASSIGNEE_CHANGED
  TASK_OVERDUE
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_IN_REVIEW
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String
  role         Role
  isActive     Boolean   @default(true)
  // Last time the user had a live socket. Drives the "events you missed" catch-up.
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens   RefreshToken[]
  projectsCreated Project[]      @relation("ProjectCreator")
  tasksAssigned   Task[]         @relation("TaskAssignee")
  tasksCreated    Task[]         @relation("TaskCreator")
  activities      ActivityLog[]
  notifications   Notification[]

  @@index([role, isActive])
}

// Refresh tokens are stored hashed (sha256) so a DB leak does not leak live sessions.
// Rotation: each refresh revokes the presented token and issues a new one.
model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Client {
  id           Int      @id @default(autoincrement())
  name         String
  contactName  String?
  contactEmail String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects Project[]
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String   @default("")
  clientId    Int
  // The PM (or admin) who owns the project. PMs can only see / manage projects where this is their id.
  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy     User           @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  tasks         Task[]
  activities    ActivityLog[]
  notifications Notification[]

  @@index([createdById])
  @@index([clientId])
}

model Task {
  // The numeric id doubles as the human readable "Task #12" shown in the feed.
  id          Int        @id @default(autoincrement())
  projectId   Int
  title       String
  description String     @default("")
  assigneeId  Int?
  createdById Int
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  // Set by the scheduled overdue job (never computed on page load).
  isOverdue   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee      User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy     User           @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  activities    ActivityLog[]
  notifications Notification[]

  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([dueDate])
  @@index([isOverdue, dueDate])
}

// Persistent, append-only audit trail. This is the source of truth for the live feed AND for the
// "events you missed" catch-up, so nothing about the feed is kept only in memory.
model ActivityLog {
  id         Int          @id @default(autoincrement())
  type       ActivityType
  taskId     Int
  // Denormalised from Task so PM/Admin feed queries can filter without joining through Task.
  projectId  Int
  // NULL = system (e.g. the overdue scheduler)
  actorId    Int?
  fromStatus TaskStatus?
  toStatus   TaskStatus?
  detail     String?
  createdAt  DateTime     @default(now())

  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([taskId, createdAt(sort: Desc)])
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  message   String
  taskId    Int?
  projectId Int?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
}
