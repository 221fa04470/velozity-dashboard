# --- Server ---
NODE_ENV=development
PORT=4000

# Postgres connection string (Neon / Supabase / Render / local docker)
DATABASE_URL=postgresql://velozity:velozity@localhost:5432/velozity?schema=public

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string-32-chars

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Comma separated list of allowed browser origins (used for CORS + Socket.io)
CLIENT_ORIGIN=http://localhost:5173

# "lax" works when the SPA proxies /api (Vercel rewrite / Vite proxy).
# Use "none" only if the browser calls the API on a different site directly (needs HTTPS).
COOKIE_SAMESITE=lax

# node-cron expression for the overdue task scanner (default: every 5 minutes)
OVERDUE_CRON=*/5 * * * *

# Password given to every seeded account
SEED_PASSWORD=Password123!
